{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super-tux-war-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // Production CORS allowlist. This committed value is the single source of
  // truth: `npm run deploy` must never depend on a CLI override, or a manual
  // deploy silently locks the live game out of its own signaling service.
  // Local development overrides it via the `dev` script in package.json.
  "vars": {
    "ALLOWED_ORIGINS": "https://mcaleerkj.github.io"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ],
  "ratelimits": [
    {
      "name": "CREATE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "JOIN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
